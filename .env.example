# Backend-only service configuration; never prefix secrets with NEXT_PUBLIC_.
# Placeholder credentials below are exclusively for local development.
DATABASE_URL=postgresql://tracker:local-placeholder-password@localhost:5432/tracker
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
OMDB_API_KEY=replace-with-omdb-key
FRONTEND_ORIGIN=http://localhost:3000
PORT=3001
BETTER_AUTH_URL=http://localhost:3001
# Development email is delivered only to loopback Mailpit.
SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
NODE_ENV=development

# Local Docker PostgreSQL configuration.
POSTGRES_USER=tracker
POSTGRES_PASSWORD=local-placeholder-password
POSTGRES_DB=tracker
POSTGRES_PORT=5432
